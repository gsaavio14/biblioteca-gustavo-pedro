<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Empréstimos</h1>
    <a href="/emprestimos/novo" class="btn btn-primary">Novo empréstimo</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Usuário</th>
            <th>Livro</th>
            <th>Data do empréstimo</th>
            <th>Devolução prevista</th>
            <th>Devolvido em</th>
            <th>Multa</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <% listaEmprestimos.forEach(function(emprestimo) { %>
            <tr>
                <td><%= emprestimo.id %></td>
                <td><%= emprestimo.usuario.nome %></td>
                <td><%= emprestimo.livro.titulo %></td>
                <td><%= dateFormat(emprestimo.dataEmprestimo) %></td>
                <td><%= dateFormat(emprestimo.dataPrevistaDevolucao) %></td>
                <td>
                    <% if (emprestimo.dataEfetivaDevolucao) { %>
                        <%= dateFormat(emprestimo.dataEfetivaDevolucao) %>
                    <% } else { %>
                        <span class="badge text-bg-warning">Em aberto</span>
                    <% } %>
                </td>
                <td><%= moneyFormat(emprestimo.valorMulta) %></td>
                <td>
                    <% if (!emprestimo.dataEfetivaDevolucao) { %>
                        <form action="/emprestimos/<%= emprestimo.id %>/devolucao" method="post">
                            <button type="submit" class="btn btn-sm btn-success">Devolver</button>
                        </form>
                    <% } %>
                </td>
            </tr>
        <% }) %>
        <% if (listaEmprestimos.length === 0) { %>
            <tr>
                <td colspan="8" class="text-center">Nenhum empréstimo cadastrado.</td>
            </tr>
        <% } %>
    </tbody>
</table>