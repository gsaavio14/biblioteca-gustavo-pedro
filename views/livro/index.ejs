<h1 class="mt-5">Consulta de Livros</h1>

<a href="/livros/novo" class="btn btn-primary mt-3">Novo livro</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>#</th>
            <th>Título</th>
            <th>Gênero</th>
            <th>Ano</th>
            <th>Exemplares</th>
            <th>Situação</th>
            <th class="text-right">Ações</th>
        </tr>
    </thead>
    <tbody>
        <% listaLivros.forEach(function(livro, index) { %>
            <tr>
                <td><%= index + 1 %></td>
                <td><%= livro.titulo %> <br> <b><small>Id: <%= livro.id %></small></b></td>
                <td><%= livro.genero %></td>
                <td><%= livro.anoPublicacao %></td>
                <td><%= livro.quantidadeDisponivel %> / <%= livro.quantidadeTotal %></td>
                <td><%- _h.rotuloDisponibilidade(livro.quantidadeDisponivel) %></td>
                <td>
                    <a href="/livros/<%= livro.id %>/atualizacao" class="btn btn-sm btn-secondary">Atualizar</a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>